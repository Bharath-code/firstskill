# Dodo Payments — https://app.dodopayments.com
# Test mode keys while developing; switch DODO_PAYMENTS_ENVIRONMENT to live_mode to charge real cards.
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_ENVIRONMENT=test_mode

# Product created in the Dodo dashboard for the $197 early-bird skill pack.
DODO_PACK_PRODUCT_ID=

# From the Dodo dashboard webhook settings. Endpoint: <your-domain>/api/webhook/dodo
DODO_PAYMENTS_WEBHOOK_SECRET=

# Used to build the post-payment return URL. e.g. https://firstskill.dev
NEXT_PUBLIC_APP_URL=http://localhost:3000
